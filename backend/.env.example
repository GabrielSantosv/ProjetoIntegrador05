# Backend configuration
# Copy this file to .env and adjust the values

# Database (PostgreSQL - used when DB_BACKEND=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Projeto_integrador
DB_USER=postgres
DB_PASSWORD=admin
DB_BACKEND=sqlite

# SQLite path (used when DB_BACKEND=sqlite)
SQLITE_PATH=./data/app.db

# File storage
MEDIA_ROOT=./media

# OCR settings
OCR_LANGUAGE=por+eng
OCR_MAX_PAGES=5
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# LLM (opcional) — habilita resumo inteligente do processo
# OPENAI_API_KEY=sk-...
