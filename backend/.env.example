# Backend configuration
# Copy this file to .env and adjust the values

# Database (PostgreSQL - used when DB_BACKEND=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME="Projeto oficial"
DB_USER=postgres
DB_PASSWORD=admin
DB_BACKEND=postgresql

# SQLite path (used when DB_BACKEND=sqlite)
SQLITE_PATH=./data/app.db

# File storage
MEDIA_ROOT=./media

# OCR settings
OCR_LANGUAGE=por+eng
OCR_MAX_PAGES=5
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# LLM (opcional) — habilita resumo inteligente do processo
# OPENAI_API_KEY=sk-...

# Auth
AUTH_DB_BACKEND=postgresql
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME="Projeto oficial"
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=admin

# SECRET_KEY=change-me-in-production-please-use-a-longer-secret
