DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=teste
DB_USER=postgres
DB_PASSWORD=admin

# Se o backend continuar usando Django com DATABASE_URL:
DATABASE_URL=postgresql://postgres:admin@localhost:5432/teste

# Se você preferir SQLite no Django, deixe DATABASE_URL vazio.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MISTRAL_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_CLASSIFIER_MODEL=neuralmind/bert-large-portuguese-cased
HF_NER_MODEL=pierreguillou/bert-base-cased-pt-lenerbr
